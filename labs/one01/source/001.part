loat32Array(16);for(let c=0;c<4;c++)for(let r=0;r<4;r++)o[c*4+r]=a[0*4+r]*b[c*4+0]+a[1*4+r]*b[c*4+1]+a[2*4+r]*b[c*4+2]+a[3*4+r]*b[c*4+3];return o}
function mTranslate(x,y,z){const m=M4();m[12]=x;m[13]=y;m[14]=z;return m}
function mScale(x,y,z){const m=M4();m[0]=x;m[5]=y;m[10]=z;return m}
function mRotX(a){const c=Math.cos(a),s=Math.sin(a),m=M4();m[5]=c;m[6]=s;m[9]=-s;m[10]=c;return m}
function mRotY(a){const c=Math.cos(a),s=Math.sin(a),m=M4();m[0]=c;m[2]=-s;m[8]=s;m[10]=c;return m}
function mRotZ(a){const c=Math.cos(a),s=Math.sin(a),m=M4();m[0]=c;m[1]=s;m[4]=-s;m[5]=c;return m}
function mTRS(p,r,s){return mMul(mTranslate(p.x,p.y,p.z),mMul(mRotY(r.y||0),mMul(mRotX(r.x||0),mMul(mRotZ(r.z||0),mScale(s.x,s.y,s.z)))))}
function perspective(fov,asp,n,f){const t=1/Math.tan(fov/2),m=new Float32Array(16);m[0]=t/asp;m[5]=t;m[10]=(f+n)/(n-f);m[11]=-1;m[14]=(2*f*n)/(n-f);return m}
function lookAt(eye,target,up){const z=norm(sub(eye,target)),x=norm(cross(up,z)),y=cross(z,x),m=M4();m[0]=x.x;m[1]=y.x;m[2]=z.x;m[4]=x.y;m[5]=y.y;m[6]=z.y;m[8]=x.z;m[9]=y.z;m[10]=z.z;m[12]=-dot(x,eye);m[13]=-dot(y,eye);m[14]=-dot(z,eye);return m}
function mInv(a){const out=new Float32Array(16),b00=a[0]*a[5]-a[1]*a[4],b01=a[0]*a[6]-a[2]*a[4],b02=a[0]*a[7]-a[3]*a[4],b03=a[1]*a[6]-a[2]*a[5],b04=a[1]*a[7]-a[3]*a[5],b05=a[2]*a[7]-a[3]*a[6],b06=a[8]*a[13]-a[9]*a[12],b07=a[8]*a[14]-a[10]*a[12],b08=a[8]*a[15]-a[11]*a[12],b09=a[9]*a[14]-a[10]*a[13],b10=a[9]*a[15]-a[11]*a[13],b11=a[10]*a[15]-a[11]*a[14];let det=b00*b11-b01*b10+b02*b09+b03*b08-b04*b07+b05*b06;if(!det)return M4();det=1/det;out[0]=(a[5]*b11-a[6]*b10+a[7]*b09)*det;out[1]=(-a[1]*b11+a[2]*b10-a[3]*b09)*det;out[2]=(a[13]*b05-a[14]*b04+a[15]*b03)*det;out[3]=(-a[9]*b05+a[10]*b04-a[11]*b03)*det;out[4]=(-a[4]*b11+a[6]*b08-a[7]*b07)*det;out[5]=(a[0]*b11-a[2]*b08+a[3]*b07)*det;out[6]=(-a[12]*b05+a[14]*b02-a[15]*b01)*det;out[7]=(a[8]*b05-a[10]*b02+a[11]*b01)*det;out[8]=(a[4]*b10-a[5]*b08+a[7]*b06)*det;out[9]=(-a[0]*b10+a[1]*b08-a[3]*b06)*det;out[10]=(a[12]*b04-a[13]*b02+a[15]*b00)*det;out[11]=(-a[8]*b04+a[9]*b02-a[11]*b00)*det;out[12]=(-a[4]*b09+a[5]*b07-a[6]*b06)*det;out[13]=(a[0]*b09-a[1]*b07+a[2]*b06)*det;out[14]=(-a[12]*b03+a[13]*b01-a[14]*b00)*det;out[15]=(a[8]*b03-a[9]*b01+a[10]*b00)*det;return out}
function transform4(m,x,y,z,w=1){return {x:m[0]*x+m[4]*y+m[8]*z+m[12]*w,y:m[1]*x+m[5]*y+m[9]*z+m[13]*w,z:m[2]*x+m[6]*y+m[10]*z+m[14]*w,w:m[3]*x+m[7]*y+m[11]*z+m[15]*w}}
