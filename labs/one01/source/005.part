s={id:e.pointerId,x:e.clientX,y:e.clientY,t:performance.now(),on,held:false};try{canvas.setPointerCapture(e.pointerId)}catch(_){}if(on){press.timer=setTimeout(()=>{if(press&&press.id===e.pointerId&&!press.held){press.held=true;beginGaze()}},650)}});
canvas.addEventListener('pointermove',e=>{if(!press||press.id!==e.pointerId)return;if(Math.hypot(e.clientX-press.x,e.clientY-press.y)>18&&press.timer){clearTimeout(press.timer);press.timer=null}});
let pendingTapTimer=null;
canvas.addEventListener('pointerup',e=>{e.preventDefault();if(!press||press.id!==e.pointerId)return;if(press.timer)clearTimeout(press.timer);if(press.held){endGaze();press=null;return}const on=press.on;press=null;if(on){if(pendingTapTimer){clearTimeout(pendingTapTimer);pendingTapTimer=null}touchReact();return}const p=rayGround(e.clientX,e.clientY);if(!p)return;const now=performance.now(),double=now-lastTap.t<245&&Math.hypot(e.clientX-lastTap.x,e.clientY-lastTap.y)<52;if(double){if(pendingTapTimer){clearTimeout(pendingTapTimer);pendingTapTimer=null}lastTap={t:0,x:0,y:0};beginMove(p,true)}else{lastTap={t:now,x:e.clientX,y:e.clientY};if(pendingTapTimer)clearTimeout(pendingTapTimer);pendingTapTimer=setTimeout(()=>{pendingTapTimer=null;if(lastTap.t===now)beginMove(p,false)},235)}});
canvas.addEventListener('pointercancel',()=>{if(press&&press.timer)clearTimeout(press.timer);if(press&&press.held)endGaze();press=null});

// hidden HUD
let taps=[];document.getElementById('hudHotspot').addEventListener('pointerup',()=>{const n=performance.now();taps=taps.filter(t=>n-t<1800);taps.push(n);if(taps.length>=5){hud.classList.add('show');taps=[];updateHUD()}});document.querySelector('.hudClose').addEventListener('pointerup',()=>hud.classList.remove('show'));

// ---------- animation / rig update ----------
function resetRig(){armL.shoulder.r.x=armR.shoulder.r.x=0;armL.shoulder.r.z=.13;armR.shoulder.r.z=-.13;armL.elbow.r.x=armR.elbow.r.x=0;legL.hip.r.x=legR.hip.r.x=0;legL.knee.r.x=legR.knee.r.x=0;torso.r.x=torso.r.z=0;pelvis.r.z=0;bodyLean=lerp(bodyLean,0,.08)}
function updateExpression(dt){exprMix=lerp(exprMix,1,clamp(dt*7,0,1));let eyeY=1,mouthX=.13,mouthY=.028,tilt=0,pitch=0;switch(expr){case'happy':eyeY=.87;mouthX=.18;mouthY=.055;break;case'curious':eyeY=1.08;mouthX=.11;mouthY=.04;tilt=.10;break;case'annoyed':eyeY=.78;mouthX=.12;mouthY=.022;tilt=-.04;break;case'shy':eyeY=.90;mouthX=.10;mouthY=.028;tilt=-.09;break;case'listening':eyeY=1.08;mouthX=.09;mouthY=.022;pitch=.03;break;case'sleepy':eyeY=.40;mouthX=.10;mouthY=.020;break;case'surprised':eyeY=1.12;mouthX=.075;mouthY=.075;break;case'soft':mouthX=.14;mouthY=.034;break}eyeL.eye.s.y=lerp(eyeL.eye.s.y,.27*eyeY,.18);eyeR.eye.s.y=lerp(eyeR.eye.s.y,.27*eyeY,.18);mouth.s.x=lerp(mouth.s.x,mouthX,.16);mouth.s.y=lerp(mouth.s.y,mouthY,.16);headTilt=lerp(headTilt,tilt,.10);headPitch=lerp(headPitch,pitch,.10)}
function updateBlink(dt){blinkT-=dt;if(blinkT<=0&&!holdGaze){blink=.16;blinkT=2.2+Math.random()*4.8}if(blink>0){blink-=dt;const k=blink>.08?clamp((.16-blink)/.08,0,1):clamp(blink/.08,0,1);const sy=.27*(1-.78*Math.sin(k*Math.PI));eyeL.eye.s.y=Math.min(eyeL.eye.s.y,sy);eyeR.eye.s.y=Math.min(eyeR.eye.s.y,sy)}}
function updateAction(dt,t){resetRig();rootSpeed=0;if(!action){setExpr(state.energy<.25?'sleepy':'neutral');return}action.t+=dt;const a=action;
 if(a.type==='move'){
   if(a.phase==='eye'){lookX=lerp(lookX,clamp(Math.sin(a.desiredYaw-root.r.y)*.75,-.7,.7),.18);headYaw=angleLerp(headYaw,(a.desiredYaw-root.r.y)*.45,.16);if(a.t>(a.hesitant?.34:.18)){a.phase='turn';a.t=0}}
   else if(a.phase==='turn'){root.r.y=angleLerp(root.r.y,a.desiredYaw,clamp(dt*5.5,0,1));headYaw=lerp(headYaw,0,.16);if(a.curiosity){headTilt=lerp(headTilt,.08,.12);setExpr('curious')}if(a.t>(a.hesitant?.46:.30)){a.phase='move';a.t=0;a.moveDuration=Math.max(.18,a.dist/a.speed)}}
   else if(a.phase==='move'){
     const q=clamp(a.t/a.moveDuration,0,1),qq=smooth(q);root.p.x=lerp(a.start.x,a.target.x,qq);root.p.z=lerp(a.start.z,a.target.z,qq);rootSpeed=a.speed;const run=a.speed>1.55,phase=t*(run?11.8:7.0),amp=run?.72:.38;legL.hip.r.x=Math.sin(phase)*amp;legR.hip.r.x=-Math.sin(phase)*amp;legL.knee.r.x=Math.max(0,-Math.sin(phase))*-.52;legR.knee.r.x=Math.max(0,Math.sin(phase))*-.52;armL.shoulder.r.x=-Math.sin(phase)*amp*.64;armR.shoulder.r.x=Math.sin(phase)*amp*.64;torso.r.x=run?.11:.04;root.p.y=BASE_Y+(run?.045:.018)*Math.abs(Math.sin(phase*1.0));if(run){armL.shoulder.r.z=.23;armR.shoulder.r.z=-.23}if(q>=1){root.p.y=BASE_Y;a.phase='settle';a.t=0;setExpr(a