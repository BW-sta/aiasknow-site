l.style.left=s.x+'px';targetEl.style.top=s.y+'px';targetEl.classList.remove('show');void targetEl.offsetWidth;targetEl.classList.add('show');setTimeout(()=>targetEl.classList.remove('show'),650)}
function chooseWeighted(items){let sum=items.reduce((s,i)=>s+i[1],0),r=Math.random()*sum;for(const i of items){r-=i[1];if(r<=0)return i[0]}return items[0][0]}
function behaviorFor(p,forceDash=false){const d=Math.hypot(p.x-root.p.x,p.z-root.p.z);const rep=n=>recent.slice(-3).includes(n)?.25:1;const items=[];if(forceDash)items.push(['dash',8]);if(d<1.0)items.push(['close_step',6*rep('close_step')]);else{items.push(['calm_walk',(1.3+state.calm*2+(.8-temp.activity))*rep('calm_walk')]);items.push(['spring_run',(1.3+temp.activity*2+state.energy)*rep('spring_run')]);items.push(['curious_approach',(1+temp.curiosity*2+state.curiosity)*rep('curious_approach')]);items.push(['hesitant_approach',(.5+(1-temp.boldness)*1.4+state.irritation)*rep('hesitant_approach')]);if(d>2.3)items.push(['dash',(.35+temp.activity*.65+state.mood*.35)*rep('dash')])}return chooseWeighted(items)}
const SPEED={close_step:.78,calm_walk:1.15,spring_run:2.05,curious_approach:1.25,hesitant_approach:.85,dash:3.1,wander:.65};
function setExpr(e,intensity=1){expr=e;exprMix=intensity}
function beginMove(p,forceDash=false){hideHint();idleSince=performance.now();scheduleIdle();holdGaze=false;const b=behaviorFor(p,forceDash);lastBehavior=b;recent.push(b);if(recent.length>8)recent.shift();const dist=Math.hypot(p.x-root.p.x,p.z-root.p.z);const to=sub(p,root.p),yaw=Math.atan2(to.x,to.z);const curious=b==='curious_approach',hes=b==='hesitant_approach';action={id:++actionId,type:'move',behavior:b,target:p,start:V3(root.p.x,0,root.p.z),desiredYaw:yaw,phase:'eye',t:0,dist,curious,hesitant:hes,speed:SPEED[b]||1.2};state.attention=clamp(state.attention+.16,0,1);state.boredom=clamp(state.boredom-.22,0,1);state.socialNeed=clamp(state.socialNeed-.08,0,1);state.energy=clamp(state.energy-(b==='dash'?.035:b.includes('run')?.022:.008),0,1);targetPulse(p);updateHUD()}
function touchReact(){hideHint();idleSince=performance.now();scheduleIdle();const now=performance.now();state.irritation=clamp(state.irritation+.075*(1.25-temp.patience),0,1);state.attention=clamp(state.attention+.18,0,1);state.mood=clamp(state.mood-.018*state.irritation,0,1);state.trust=clamp(state.trust-.010*Math.max(0,state.irritation-.35),0,1);let b;if(state.irritation>.48)b=Math.random()<.52?'step_back':'tiny_annoyed';else b=chooseWeighted([['soft_happy',2+temp.affection],['curious_touch',1.5+temp.curiosity],['shy',1.0+(1-temp.boldness)]]);lastBehavior=b;action={id:++actionId,type:'react',behavior:b,phase:'react',t:0,duration:b==='step_back'?.85:.72};setExpr(b==='tiny_annoyed'||b==='step_back'?'annoyed':b==='shy'?'shy':b==='curious_touch'?'curious':'happy');updateHUD()}
function beginGaze(){hideHint();holdGaze=true;idleSince=performance.now();scheduleIdle();lastBehavior='gaze_hold';action={id:++actionId,type:'gaze',behavior:'gaze_hold',phase:'hold',t:0};setExpr('listening');state.attention=clamp(state.attention+.25,0,1);state.socialNeed=clamp(state.socialNeed-.1,0,1);updateHUD()}
function endGaze(){if(!holdGaze)return;holdGaze=false;scheduleIdle();lastBehavior='gaze_release';action={id:++actionId,type:'react',behavior:'gaze_release',phase:'release',t:0,duration:.55};setExpr('soft');updateHUD()}
function idleBehavior(){if(action||holdGaze)return;const choices=[['look_around',2.5],['shift_weight',2.0],['inspect_hands',1.25+temp.curiosity],['stretch',1.2],['sit',state.energy<.45?2.8:.7],['look_user',.8+state.socialNeed*2],['wander',.7+state.boredom*2.2]];const b=chooseWeighted(choices.map(i=>[i[0],i[1]*(recent.slice(-2).includes(i[0])?.25:1)]));recent.push(b);if(recent.length>8)recent.shift();lastBehavior=b;if(b==='wander'){const a=Math.random()*Math.PI*2,r=.55+Math.random()*1.1;let p=V3(root.p.x+Math.sin(a)*r,0,root.p.z+Math.cos(a)*r);const rr=Math.sqrt((p.x*p.x)/(4.1*4.1)+(p.z*p.z)/(3.25*3.25));if(rr>1){p.x/=rr;p.z/=rr}action={id:++actionId,type:'move',behavior:'wander',target:p,start:V3(root.p.x,0,root.p.z),desiredYaw:Math.atan2(p.x-root.p.x,p.z-root.p.z),phase:'eye',t:0,dist:Math.hypot(p.x-root.p.x,p.z-root.p.z),speed:SPEED.wander}}else action={id:++actionId,type:'idleAction',behavior:b,phase:b,t:0,duration:b==='sit'?2.8:1.35};state.boredom=clamp(state.boredom-.08,0,1);updateHUD()}

