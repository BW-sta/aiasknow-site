=0;x<=seg;x++){const u=x/seg,th=u*Math.PI*2,s=Math.sin(phi),px=Math.cos(th)*s,py=Math.cos(phi),pz=Math.sin(th)*s;p.push(px,py,pz);n.push(px,py,pz)}}for(let y=0;y<rings;y++)for(let x=0;x<seg;x++){const a=y*(seg+1)+x,b=a+seg+1;idx.push(a,b,a+1,b,b+1,a+1)}return upload(p,n,idx)}
function makeDisc(seg=64){const p=[0,0,0],n=[0,1,0],idx=[];for(let i=0;i<=seg;i++){const a=i/seg*Math.PI*2;p.push(Math.cos(a),0,Math.sin(a));n.push(0,1,0)}for(let i=1;i<=seg;i++)idx.push(0,i,i+1);return upload(p,n,idx)}
function upload(p,n,idx){const o={v:gl.createBuffer(),n:gl.createBuffer(),i:gl.createBuffer(),count:idx.length};gl.bindBuffer(gl.ARRAY_BUFFER,o.v);gl.bufferData(gl.ARRAY_BUFFER,new Float32Array(p),gl.STATIC_DRAW);gl.bindBuffer(gl.ARRAY_BUFFER,o.n);gl.bufferData(gl.ARRAY_BUFFER,new Float32Array(n),gl.STATIC_DRAW);gl.bindBuffer(gl.ELEMENT_ARRAY_BUFFER,o.i);gl.bufferData(gl.ELEMENT_ARRAY_BUFFER,new Uint16Array(idx),gl.STATIC_DRAW);return o}
const sphere=makeSphere(28,20), sphereLow=makeSphere(18,12), disc=makeDisc(72);
const C={skin:[.43,.78,.68],skinLight:[.56,.86,.78],skinDark:[.29,.62,.54],cloth:[.93,.89,.78],cloth2:[.21,.31,.30],eye:[.035,.055,.050],pupil:[.008,.012,.011],mouth:[.15,.23,.21],ground:[.89,.88,.82],stone:[.70,.75,.70],shadow:[.12,.17,.14],white:[.98,.99,.96]};
function part(mesh,color,gloss=.15,opacity=1){return {mesh,color,gloss,opacity,em:[0,0,0],p:V3(),r:V3(),s:V3(1,1,1),parent:null,world:M4(),visible:true}}
function node(parent=null,p=V3()){const o=part(null,[0,0,0],0,0);o.parent=parent;o.p=p;o.visible=false;return o}
function worldOf(o){const local=mTRS(o.p,o.r,o.s);o.world=o.parent?mMul(o.parent.world,local):local;return o.world}
function draw(o,vp){worldOf(o);if(!o.mesh||!o.visible)return;gl.uniformMatrix4fv(loc.model,false,o.world);gl.uniformMatrix3fv(loc.nmat,false,normalMat3(o.world));gl.uniform3fv(loc.color,o.color);gl.uniform3fv(loc.em,o.em);gl.uniform1f(loc.opacity,o.opacity);gl.uniform1f(loc.gloss,o.gloss);gl.bindBuffer(gl.ARRAY_BUFFER,o.mesh.v);gl.enableVertexAttribArray(loc.pos);gl.vertexAttribPointer(loc.pos,3,gl.FLOAT,false,0,0);gl.bindBuffer(gl.ARRAY_BUFFER,o.mesh.n);gl.enableVertexAttribArray(loc.normal);gl.vertexAttribPointer(loc.normal,3,gl.FLOAT,false,0,0);gl.bindBuffer(gl.ELEMENT_ARRAY_BUFFER,o.mesh.i);gl.drawElements(gl.TRIANGLES,o.mesh.count,gl.UNSIGNED_SHORT,0)}

// ---------- scene ----------
let W=1,H=1,DPR=1;const camera=V3(0,5.0,8.6),target=V3(0,1.45,0),up=V3(0,1,0);let vp=M4(), invVP=M4();
function resize(){DPR=Math.min(window.devicePixelRatio||1,1.7);W=canvas.clientWidth;H=canvas.clientHeight;canvas.width=Math.round(W*DPR);canvas.height=Math.round(H*DPR);gl.viewport(0,0,canvas.width,canvas.height);const pr=perspective(36*Math.PI/180,W/H,.1,40);vp=mMul(pr,lookAt(camera,target,up));invVP=mInv(vp);gl.uniformMatrix4fv(loc.vp,false,vp);gl.uniform3f(loc.camera,camera.x,camera.y,camera.z)}window.addEventListener('resize',resize);resize();
gl.enable(gl.DEPTH_TEST);gl.depthFunc(gl.LEQUAL);gl.enable(gl.CULL_FACE);gl.cullFace(gl.BACK);gl.enable(gl.BLEND);gl.blendFunc(gl.SRC_ALPHA,gl.ONE_MINUS_SRC_ALPHA);gl.clearColor(0,0,0,0);

const ground=part(disc,C.ground,.02,1);ground.s=V3(5.0,1,4.2);ground.p=V3(0,-.03,0);
const shadow=part(disc,C.shadow,.01,.18);shadow.s=V3(.75,1,.48);shadow.p=V3(0,.005,0);
const stones=[];[[ -3.1,.03,-1.0,.26],[2.9,.02,-1.3,.18],[-2.5,.02,1.6,.14],[2.7,.02,1.35,.22]].forEach(a=>{const s=part(sphereLow,C.stone,.03,.54);s.p=V3(a[0],a[1],a[2]);s.s=V3(a[3]*1.5,a[3]*.28,a[3]);stones.push(s)});

// ---------- articulated procedural rig ----------
const BASE_Y=.34;
const root=node(null,V3(0,BASE_Y,0));root.r=V3(0,0,0);root.s=V3(1,1,1);
const pelvis=part(sphere,C.skin);pelvis.parent=root;pelvis.p=V3(0,.93,0);pelvis.s=V3(.50,.44,.39);
const torso=part(sphere,C.cloth,.08);torso.parent=root;torso.p=V3(0,1.33,0);torso.s=V3(.62,.70,.47);
const torsoInner=part(sphere,C.cloth2,.09);torsoInner.parent=root;torsoInner.p=V3(0,1.50,.42);torsoInner.s=V3(.20,.28,.035);
const head=part(sphere,C.skin,.12);head.parent=root;head.p=V3(0,2.23,0);head.s=V3(.93,.77,.72);
const cheekL=part(sphere,C.skinLight,.05,.18);cheekL.parent=head;cheekL.p=V3(-.36,-.17,.65);cheekL.s=V3(.20,.11,.03);
const cheekR=part(sphere,C.skinLight,.05,.18);cheekR.parent=head;cheekR.p=V3(.36,-.17,.65);cheekR.s=V3(.20,.11,.03);

function makeEye(x){const e=part(sphere,C.eye,.72);e.parent=head;e.p=V3(x,.05,.69);e.s=V3(.20,.27,.105);const hi=part(sphere,C.white,.9);hi.parent=e;hi.p=V3(-.28,.25,.83);hi.s=V3(.22,.20,.08);return {