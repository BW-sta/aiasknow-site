const temp={activity:.64,sociability:.56,curiosity:.72,patience:.62,boldness:.48,affection:.59};
const state={energy:.82,mood:.66,curiosity:.70,attention:.56,trust:.48,boredom:.15,socialNeed:.50,irritation:.02,calm:.72};
let lastT=performance.now(),action=null,actionId=0,idleSince=performance.now(),lastBehavior='',recent=[],press=null,lastTap={t:0,x:0,y:0},hintHidden=false,blinkT=2+Math.random()*3,blink=0,lookX=0,lookY=0,expr='neutral',exprMix=0,headYaw=0,headPitch=0,headTilt=0,bodyLean=0,rootSpeed=0,lastRootYaw=0,holdGaze=false,nextIdleAt=performance.now()+6500+Math.random()*7000;
const hint=document.getElementById('hint'),targetEl=document.getElementById('target'),hud=document.getElementById('hud'),decisionEl=document.getElementById('decision'),stateEl=document.getElementById('state');
function updateHUD(){decisionEl.textContent=`行为: ${lastBehavior||'idle'}\n阶段: ${action?action.phase:'none'}\n人格: activity ${temp.activity.toFixed(2)} · curiosity ${temp.curiosity.toFixed(2)} · patience ${temp.patience.toFixed(2)}`;stateEl.innerHTML=Object.entries(state).map(([k,v])=>`<div>${k}<br><b>${v.toFixed(2)}</b></div>`).join('')}
function scheduleIdle(){nextIdleAt=performance.now()+5500+Math.random()*8500}
function hideHint(){if(!hintHidden){hintHidden=true;hint.classList.add('hide')}}
function worldToScreen(p){const c=transform4(vp,p.x,p.y,p.z,1);if(!c.w)return{x:0,y:0};const nx=c.x/c.w,ny=c.y/c.w;return{x:(nx*.5+.5)*W,y:(1-(ny*.5+.5))*H}}
function rayGround(clientX,clientY){const rect=canvas.getBoundingClientRect(),nx=((clientX-rect.left)/rect.width)*2-1,ny=1-((clientY-rect.top)/rect.height)*2;let a=transform4(invVP,nx,ny,-1,1),b=transform4(invVP,nx,ny,1,1);a=V3(a.x/a.w,a.y/a.w,a.z/a.w);b=V3(b.x/b.w,b.y/b.w,b.z/b.w);const d=sub(b,a);if(Math.abs(d.y)<1e-5)return null;const t=-a.y/d.y;if(t<0)return null;let p=add(a,mul(d,t));const rr=Math.sqrt((p.x*p.x)/(4.5*4.5)+(p.z*p.z)/(3.65*3.65));if(rr>1){p.x/=rr;p.z/=rr}return p}
function hitCreature(x,y){const sc=worldToScreen(add(root.p,V3(0,1.55,0)));const r=Math.min(W,H)*.15;return Math.hypot(x-sc.x,y-sc.y)<r}
